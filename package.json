{
  "name": "railrunner",
  "productName": "RailRunner",
  "version": "2.1.0",
  "description": "Rail Runner: an endless 3D runner on three railway tracks through a whole city, with characters, missions and a daily challenge; in the browser and as a desktop app",
  "author": "ALEXalesha",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/ALEXalesha/RailRunner",
  "versionFiles": [
    "web/js/app.js"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "test:web": "playwright test --workers=1",
    "test:app": "playwright test --config=playwright.app.config.js --workers=1",
    "mutate": "node tools/mutate.js",
    "screens": "node tools/screenshots.js",
    "vendor": "node tools/build-vendor.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.alexalesha.railrunner",
    "productName": "RailRunner",
    "copyright": "Copyright (c) 2026 ALEXalesha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "assets/icon.ico",
      "assets/icon.png",
      "LICENSE",
      "!**/*.map"
    ],
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "compression": "maximum",
    "publish": null,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "RailRunner-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "RailRunner-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RailRunner"
    }
  }
}
